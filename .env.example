# ClaimGuard Environment Configuration Example
# Set to 'true' to use local mock providers without requiring AWS credentials or external APIs
CLAIMGUARD_MOCK_MODE=true

# Next.js Public
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Storage Provider (AWS S3)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=claimguard-receipts

# Document Intelligence (AWS Textract)
AWS_TEXTRACT_REGION=ap-south-1

# AI Risk Explanation (AWS Bedrock)
AWS_BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# WhatsApp Cloud Platform Adapter
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# India Verification APIs (Optional / Advanced)
GST_PORTAL_API_KEY=
