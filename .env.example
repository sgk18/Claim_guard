# ClaimGuard Environment Configuration Example
# Set to 'true' (default) to use local mock providers without requiring AWS credentials.
# Set to 'false' to route OCR AND risk explanations through AWS Bedrock -- requires
# valid AWS credentials in the environment (standard AWS credential chain:
# AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY, an AWS_PROFILE, or an IAM role).
#
# COST NOTE: Anthropic Claude models on Bedrock are NOT part of AWS's free tier --
# they bill per token from the first call. Before setting this to 'false', confirm
# your account's actual free-tier/paid-tier status (`aws freetier get-account-plan-state`,
# then check the Free Tier / Paid Tier supported-services lists) so OCR calls on every
# receipt upload don't produce unexpected charges.
CLAIMGUARD_MOCK_MODE=true

# Next.js Public
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Storage Provider (AWS S3)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=claimguard-receipts

# Document Intelligence (AWS Textract) -- kept as an alternative OCR provider
# (src/services/ocr/textract.ts), not wired in by default. Must be the project's
# assigned Region.
AWS_TEXTRACT_REGION=ap-south-1

# AI (AWS Bedrock) -- used for BOTH receipt OCR (vision) and risk explanation text.
# Region defaults to AWS_REGION if unset; confirm the chosen model is enabled/available
# in that Region, and vision-capable, before setting CLAIMGUARD_MOCK_MODE=false.
AWS_BEDROCK_REGION=ap-south-1
AWS_BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
# Optional: use a different (e.g. cheaper/free-tier-eligible) model for OCR specifically.
# Falls back to AWS_BEDROCK_MODEL_ID if unset. Must support image input.
AWS_BEDROCK_OCR_MODEL_ID=

# WhatsApp Cloud Platform Adapter
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# India Verification APIs (Optional / Advanced)
GST_PORTAL_API_KEY=

# Database: AWS Aurora PostgreSQL (server/). Leave DB_HOST empty to use in-memory demo data.
# With no DB_PASSWORD the server signs in with a short-lived IAM auth token, using the standard
# AWS credential chain (set AWS_PROFILE locally, or an IAM role on AWS).
DB_HOST=
DB_PORT=5432
DB_USER=postgres
DB_NAME=postgres
DB_SCHEMA=app
DB_REGION=ap-southeast-2
# DB_PASSWORD=
# DB_SSL_CA=          # optional PEM path to trust the RDS CA bundle on non-express clusters
# DB_POOL_MAX=10
# DB_CONNECT_TIMEOUT_MS=20000
# Setup:  cd server && npm run build && npm run db:migrate && npm run db:seed
