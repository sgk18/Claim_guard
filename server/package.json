{
  "name": "claimguard-server",
  "version": "1.0.0",
  "description": "ClaimGuard Standalone Financial Verification Backend API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "node --loader ts-node/esm src/index.ts",
    "build": "tsc",
